# Application settings
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Frontend settings
VITE_API_URL=http://localhost:8000
VITE_PORT=3000

# CORS settings (comma-separated lists)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization
CORS_EXPOSE_HEADERS=
CORS_MAX_AGE=600

# Google OAuth settings
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRATION_HOURS=24

# LLM provider settings ("ollama", "openrouter", or "anthropic")
LLM_PROVIDER=ollama
MODEL_NAME=llama2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_THINKING=true
OLLAMA_API_KEY=
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=

# Per-agent LLM overrides (leave empty to use global LLM_PROVIDER / MODEL_NAME)
GENERAL_AGENT_LLM_PROVIDER=
GENERAL_AGENT_MODEL_NAME=
DOCUMENT_AGENT_LLM_PROVIDER=
DOCUMENT_AGENT_MODEL_NAME=
VALIDATION_AGENT_LLM_PROVIDER=
VALIDATION_AGENT_MODEL_NAME=

# Redis settings
REDIS_URL=redis://default:slmlab@localhost:6379/0
REDIS_PASSWORD=slmlab
REDIS_ENABLED=false
REDIS_SESSION_TTL_DAYS=30

# PostgreSQL settings
POSTGRES_URL=postgresql+asyncpg://slmlab:slmlab@localhost:5432/slmlab
POSTGRES_ENABLED=false
POSTGRES_USER=slmlab
POSTGRES_PASSWORD=slmlab
POSTGRES_DB=slmlab
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_RECYCLE=3600
POSTGRES_POOL_PRE_PING=true

# Qdrant settings
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=slmlab
QDRANT_ENABLED=false
QDRANT_COLLECTION_NAME=slmlab
QDRANT_GRPC_PORT=6334

# Embedding settings
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_CHUNK_SIZE=1000
EMBEDDING_CHUNK_OVERLAP=200

# Archive retry settings
ARCHIVE_MAX_RETRIES=3
ARCHIVE_RETRY_DELAY=1.0
ARCHIVE_TIMEOUT=30.0

# External service API keys
BRAVE_SEARCH_API_KEY=YOUR_BRAVE_SEARCH_API_KEY_HERE

# General Agent Tool Toggles
GENERAL_AGENT_DATE_TIME_TOOL=true
GENERAL_AGENT_BRAVE_SEARCH_TOOL=true
GENERAL_AGENT_PYTHON_REPL_TOOL=true
GENERAL_AGENT_OLLAMA_WEB_SEARCH_TOOL=true
GENERAL_AGENT_OLLAMA_WEB_FETCH_TOOL=true
GENERAL_AGENT_READ_FILE_CONTENT_TOOL=true
GENERAL_AGENT_SEARCH_CHUNKS_TOOL=true
GENERAL_AGENT_DELEGATE_TOOL=false
GENERAL_AGENT_WEB_PAGE_CONTENT_TOOL=true
GENERAL_AGENT_SEND_TELEGRAM_MESSAGE_TOOL=false
GENERAL_AGENT_SET_REMINDER_TOOL=true

# Document Agent Tool Toggles
DOCUMENT_AGENT_DATE_TIME_TOOL=false
DOCUMENT_AGENT_BRAVE_SEARCH_TOOL=false
DOCUMENT_AGENT_PYTHON_REPL_TOOL=false
DOCUMENT_AGENT_OLLAMA_WEB_SEARCH_TOOL=false
DOCUMENT_AGENT_OLLAMA_WEB_FETCH_TOOL=false
DOCUMENT_AGENT_READ_FILE_CONTENT_TOOL=false
DOCUMENT_AGENT_SEARCH_CHUNKS_TOOL=false
DOCUMENT_AGENT_DELEGATE_TOOL=false
DOCUMENT_AGENT_WEB_PAGE_CONTENT_TOOL=false

# Validation Agent Tool Toggles
VALIDATION_AGENT_DATE_TIME_TOOL=false
VALIDATION_AGENT_BRAVE_SEARCH_TOOL=true
VALIDATION_AGENT_OLLAMA_WEB_SEARCH_TOOL=false
VALIDATION_AGENT_OLLAMA_WEB_FETCH_TOOL=false
VALIDATION_AGENT_WEB_PAGE_CONTENT_TOOL=true

# LangSmith settings
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=SLM Lab

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_SESSION_ID=telegram_main
TELEGRAM_BOT_USER_ID=telegram_bot_user
TELEGRAM_AGENT_LLM_PROVIDER=
TELEGRAM_AGENT_MODEL_NAME=

# Reminder Agent
REMINDER_AGENT_LLM_PROVIDER=
REMINDER_AGENT_MODEL_NAME=gemma4:latest
REMINDER_AGENT_DATE_TIME_TOOL=true
REMINDER_AGENT_BRAVE_SEARCH_TOOL=true
REMINDER_AGENT_PYTHON_REPL_TOOL=false
REMINDER_AGENT_OLLAMA_WEB_SEARCH_TOOL=false
REMINDER_AGENT_OLLAMA_WEB_FETCH_TOOL=false
REMINDER_AGENT_WEB_PAGE_CONTENT_TOOL=true
REMINDER_AGENT_SEND_TELEGRAM_MESSAGE_TOOL=true